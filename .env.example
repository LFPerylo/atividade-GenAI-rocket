OPENROUTER_API_KEY=
OPENROUTER_MODELS=["nvidia/nemotron-3-super-120b-a12b:free","apodex/apodex-1.1-mini:free","inclusionai/ling-3.0-flash-sante:free","nvidia/nemotron-3.5-lightning:free","google/gemma-4-31b-it:free","openrouter/free"]

GOOGLE_API_KEY=
GEMINI_MODELS=["gemini-flash-latest","gemini-flash-lite-latest"]

DATABASE_PATH=data/cinerocket.db
APP_DB_PATH=data/app.db
INDEX_DIR=data/index
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

FEW_SHOT_LIMIT=3
FEW_SHOT_MIN_SCORE=0.35

MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=45
LLM_TIMEOUT_SECONDS=45
AGENT_REQUEST_LIMIT=8
AGENT_RETRIES=3
HISTORY_MAX_TURNS=6
CACHE_TTL_SECONDS=86400

API_URL=http://localhost:8000
LOG_LEVEL=INFO
